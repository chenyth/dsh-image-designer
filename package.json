{
  "name": "dsh-image-designer",
  "version": "0.1.0",
  "description": "Commission Shenhuo AI image designers from DeepSeek Harness using your personal account and credits.",
  "type": "module",
  "main": "src/index.js",
  "exports": { ".": "./src/index.js", "./package.json": "./package.json" },
  "files": ["src", "skills", "assets/icon.png", "docs", "cordis.patch.yml", "README.md", "README.en.md", "LICENSE"],
  "scripts": {
    "test": "node --test test/*.test.js",
    "check": "node --check src/index.js && node --check src/oauth.js && node --check src/mcp.js && node --check src/files.js",
    "doctor": "node src/cli.js doctor",
    "connect": "node src/cli.js connect",
    "prepack": "npm run check"
  },
  "engines": { "node": ">=24.9.0" },
  "dependencies": { "@modelcontextprotocol/sdk": "1.32.2" },
  "keywords": ["dsh-plugin", "deepseek-harness", "shenhuo", "image-generation", "image-design", "mcp", "oauth"],
  "author": "chenyth",
  "license": "MIT",
  "repository": { "type": "git", "url": "git+https://github.com/chenyth/dsh-image-designer.git" },
  "bugs": { "url": "https://github.com/chenyth/dsh-image-designer/issues" },
  "homepage": "https://github.com/chenyth/dsh-image-designer#readme",
  "meta": { "title": "神火图片设计师", "description": "用神火个人账号完成设计师匹配、素材上传、设计提案、报价确认与图片交付。" },
  "icon": "./assets/icon.png",
  "dsh": { "engines": { "dsh": ">=0.2.1-rc.5 <0.2.2-0 || >=0.2.2-alpha.2 <0.3.0-0" }, "bundle": { "patch": "./cordis.patch.yml" } }
}
